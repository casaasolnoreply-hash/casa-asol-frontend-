# ─────────────────────────────────────────────
#  CASA ASOL — Plantilla de variables de entorno
#  Copia este archivo como ".env" y rellena los valores
# ─────────────────────────────────────────────

# ── Credenciales del panel administrador ──────
VITE_ADMIN_USER=admin
VITE_ADMIN_PASS=cambia_esta_contrasena

# ── Login con Google (opcional) ───────────────
# Vacío = el botón "Continuar con Google" no se muestra.
# Mismo Client ID que GOOGLE_CLIENT_ID en backend/.env
VITE_GOOGLE_CLIENT_ID=
